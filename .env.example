# LLM Configuration
# Fill these in your local .env only. Do not commit real API keys or private endpoints.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Embedding: openai | local
EMBEDDING_MODEL=
EMBEDDING_PROVIDER=local
# Example local path after you download a model yourself:
# LOCAL_EMBEDDING_PATH=./model_embedding/<your-embedding-model>
LOCAL_EMBEDDING_PATH=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Vector Store: chroma | pgvector
VECTOR_STORE_TYPE=chroma
VECTOR_COLLECTION_NAME=knowledge_chunks
CHROMA_HOST=localhost
CHROMA_PORT=8000

# PGVector (if VECTOR_STORE_TYPE=pgvector)
PGVECTOR_DSN=

# Kafka (CDC)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DOC_CHANGES=doc-changes
KAFKA_TOPIC_KG_UPDATES=kg-updates

# API
API_HOST=0.0.0.0
API_PORT=8080

# Document/runtime paths
UPLOAD_DIR=./uploads
CONVERSATION_HISTORY_FILE=./runtime/conversation_history.json
MAX_HISTORY_MESSAGES=10

# Local text generation model. Download manually; model_texttotext/ is not committed.
LOCAL_TEXT_GENERATION_PATH=
LOCAL_TEXT_GENERATION_MAX_NEW_TOKENS=256

